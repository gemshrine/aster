# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Domain pointing at this VPS; Caddy gets a Let's Encrypt certificate for it.
ASTER_DOMAIN=aster.example.com

# Exactly two users: id:token,id:token. Generate each token with `openssl rand -hex 32`.
ASTER_USERS=alice:CHANGE_ME,bob:CHANGE_ME

# Shared secret for coturn's time-limited credentials. `openssl rand -hex 32`.
TURN_SECRET=CHANGE_ME
